    "deploy": "node --experimental-strip-types ops/preflight.ts && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}

{
  "name": "chatgpt2api-cf-wrapper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts && python3 -m unittest container/test_r2sync.py",

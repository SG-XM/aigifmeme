# Uptown environment variables
#
#   cp .env.example .env.development     # local dev, gitignored
#
# Almost nothing belongs here. The chat model, video providers, payments,
# OAuth, email, storage, Google Analytics, and Clarity are entered in the
# admin panel and stored in the database — see the README. Env vars of the
# same name still work as a fallback, but database values win.
#
# Admin app_name / app_description override VITE_APP_NAME / VITE_APP_DESCRIPTION
# for the default title, default description, email From name, and chat persona.
# Clarity is clarity_project_id (Analytics tab). Leave it empty to stay off.
# Do not put production Worker/D1 ids or secrets here.
# wrangler.jsonc is committed with placeholder database_id only.
# .env.production stays gitignored.
#
# Fresh deploy (do not reuse another product's Worker, D1, R2, or zone):
#   Worker: uptown   (workers_dev enabled)
#   D1:     uptown-db
#   Site:   https://uptownfunkai.video
#   Media:  https://media.uptownfunkai.video
#   1. npx wrangler d1 create uptown-db
#   2. Put the real database_id in local wrangler.jsonc only
#   3. wrangler secret put AUTH_SECRET
#   4. wrangler secret put CONFIG_ENCRYPTION_KEY
#   5. Add the uptownfunkai.video zone, then pnpm cf:deploy

# --- Required ---------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Uptown
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# openssl rand -base64 32
AUTH_SECRET=

# --- Recommended ------------------------------------------------------------
# Encrypts the secrets you save in the admin panel (AES-256-GCM). Leave it
# unset and they are stored as plain text. Once set, keep it: rotating it
# orphans everything already encrypted under the old key.
# openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
VITE_APP_DESCRIPTION=Create and refine AI video clips through conversation.
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=en

# Other databases. DATABASE_PROVIDER: sqlite | postgres | mysql | turso | d1
#   postgres   postgresql://HOST:5432/DBNAME   prefix with USER:PASSWORD@
#   mysql      mysql://HOST:3306/DBNAME        same
#   turso      libsql://DBNAME.turso.io        also set DATABASE_AUTH_TOKEN
# DATABASE_AUTH_TOKEN=

# Extra origins allowed to call the auth API, comma-separated. A leading dot
# is a hostname suffix wildcard, e.g. `.e2b.app` for sandbox previews.
# AUTH_TRUSTED_ORIGINS=

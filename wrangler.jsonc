{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filemeta",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://filemetawipe.com",
    "VITE_APP_NAME": "FileMeta Wipe"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filemeta-db",
      "database_id": "67be1d54-0ac7-41b2-8d7a-fa83cb55d35a",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    { "pattern": "filemetawipe.com/*", "zone_name": "filemetawipe.com" },
    { "pattern": "www.filemetawipe.com/*", "zone_name": "filemetawipe.com" }
  ]
}

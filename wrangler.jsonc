{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptown",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://uptownfunkai.video",
    "VITE_APP_NAME": "Uptown"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptown-db",
      "database_id": "6697f808-69d8-45d9-9712-c0de353be191",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    { "pattern": "uptownfunkai.video/*", "zone_name": "uptownfunkai.video" },
    { "pattern": "www.uptownfunkai.video/*", "zone_name": "uptownfunkai.video" }
  ]
}

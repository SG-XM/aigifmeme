{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aigifmeme",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://aigifmeme.com",
    "VITE_APP_NAME": "AIGifMeme"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aigifmeme-db",
      "database_id": "c8ef31b5-747f-4fda-9aa2-a58bc58d8eba",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    { "pattern": "aigifmeme.com/*", "zone_name": "aigifmeme.com" },
    { "pattern": "www.aigifmeme.com/*", "zone_name": "aigifmeme.com" }
  ]
}

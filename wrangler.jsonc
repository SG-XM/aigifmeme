{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aigifmeme",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://aigifmeme.com",
    "VITE_APP_NAME": "AIGifMeme"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aigifmeme-db",
      "database_id": "518baea3-8584-4ae8-bef2-268c735140f7",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GIF_PACK_BUCKET",
      "bucket_name": "aigifmeme"
    }
  ],
  "routes": [
    { "pattern": "aigifmeme.com/*", "zone_name": "aigifmeme.com" },
    { "pattern": "www.aigifmeme.com/*", "zone_name": "aigifmeme.com" }
  ]
}
